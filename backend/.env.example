# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma se alag karke kai origins de sakte hain (web admin + Expo web dev)
CLIENT_URL=http://localhost:5173,http://localhost:8081,http://localhost:19006

# ---- Database (XAMPP MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erpsc_saas
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# ---- Default admin created by `npm run db:seed` ----
SEED_ADMIN_NAME=School Admin
SEED_ADMIN_EMAIL=admin@school.com
SEED_ADMIN_PASSWORD=admin123

# ---- Roz ka backup (Super Admin -> Backups) ----
# DB dump + uploads/ + private/ -> encrypted .erpscbk. Chalu by default.
BACKUP_ENABLED=true
# School timezone (SCHOOL_TZ) me roz is time ke baad
BACKUP_TIME=02:00
# ZAROOR set kijiye aur kahin safe likh lijiye - iske bina backup nahi khulega.
# Khaali = JWT_SECRET se (tab restore ke liye wahi .env chahiye).
BACKUP_PASSWORD=
# Server par kitne din ke (sabse naye 3 hamesha rahte hain)
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=/var/backups/erpsc
# BACKUP_MYSQLDUMP=/usr/bin/mysqldump
# BACKUP_MYSQL=/usr/bin/mysql
# Roz ki report (OK / FAIL) is email par
BACKUP_REPORT_EMAIL=

# Cloud copy - koi bhi S3-compatible: Cloudflare R2 (10 GB free), Backblaze B2, AWS S3, Wasabi
# R2: Dashboard -> R2 -> bucket banaiye -> "Manage R2 API Tokens" (Object Read & Write)
BACKUP_S3_ENDPOINT=
# R2 ke liye "auto", AWS ke liye jaise ap-south-1
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=erpsc-backups
BACKUP_S3_KEEP_DAYS=30

# ---- Email (backup report ke liye) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=aapka@gmail.com,
# SMTP_PASS = Google "App password" (2-step verification ke baad banta hai - normal password nahi)
# Khaali = mail backups/outbox.log me likh di jaati hai
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
